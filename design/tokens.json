{
  "$description": "AXIOM semantic design tokens. Compatible in structure with Tokens Studio for Figma; each mode maps to a Figma variable mode.",
  "global": {
    "brand": {
      "50": "#EEF2FF", "100": "#E0E7FF", "200": "#C7D2FE", "300": "#A5B4FC",
      "400": "#818CF8", "500": "#6366F1", "600": "#4F46E5", "700": "#4338CA",
      "violet500": "#8B5CF6", "violet400": "#A78BFA"
    },
    "feedback": { "green500": "#22C55E", "amber500": "#F59E0B", "red500": "#EF4444", "cyan500": "#22D3EE" },
    "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 14, "2xl": 20, "full": 999 },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64 },
    "font": {
      "sans": "Inter / SF Pro Text / system-ui",
      "mono": "JetBrains Mono / SF Mono / ui-monospace",
      "styles": {
        "display": { "size": 32, "lineHeight": 38, "weight": 640, "tracking": -0.045 },
        "h1": { "size": 26, "lineHeight": 32, "weight": 640, "tracking": -0.032 },
        "h2": { "size": 19, "lineHeight": 25, "weight": 620, "tracking": -0.022 },
        "h3": { "size": 15, "lineHeight": 20, "weight": 600, "tracking": -0.012 },
        "body": { "size": 13, "lineHeight": 20, "weight": 400, "tracking": 0 },
        "bodySmall": { "size": 11.5, "lineHeight": 17, "weight": 400, "tracking": 0 },
        "caption": { "size": 10, "lineHeight": 15, "weight": 400, "tracking": 0 },
        "eyebrow": { "size": 10, "lineHeight": 14, "weight": 700, "tracking": 0.1, "uppercase": true },
        "mono": { "size": 11.5, "lineHeight": 18, "weight": 400, "tracking": -0.01 }
      }
    },
    "layout": { "topbar": 56, "statusbar": 28, "tabstrip": 40, "sidebar": 248, "contextPanel": 324, "sidebarCollapsed": 60 }
  },
  "semantic": {
    "dark": {
      "bg.base": "#0A0C10", "bg.sidebar": "#0C0F14", "bg.surface": "#11141B",
      "bg.elevated": "#181C25", "bg.overlay": "#1D222D", "bg.hover": "#1A1F29",
      "bg.active": "#202632", "bg.inset": "#0D1016", "bg.scrim": "rgba(4,6,10,.72)",
      "text.primary": "#F1F5F9", "text.secondary": "#94A3B8", "text.tertiary": "#67748A",
      "text.inverse": "#0A0C10", "text.accent": "#A5B4FC",
      "border.subtle": "#1B202A", "border.default": "#252A35", "border.strong": "#343B49", "border.accent": "#4F46E5",
      "accent.default": "#6366F1", "accent.hover": "#818CF8", "accent.soft": "rgba(99,102,241,.13)",
      "status.success": "#22C55E", "status.warning": "#F59E0B", "status.danger": "#EF4444", "status.info": "#38BDF8"
    },
    "light": {
      "bg.base": "#F7F8FB", "bg.sidebar": "#F1F3F8", "bg.surface": "#FFFFFF",
      "bg.elevated": "#FFFFFF", "bg.overlay": "#FFFFFF", "bg.hover": "#EFF1F7",
      "bg.active": "#E7EAFB", "bg.inset": "#F5F6FA", "bg.scrim": "rgba(15,23,42,.32)",
      "text.primary": "#101827", "text.secondary": "#556178", "text.tertiary": "#808BA0",
      "text.inverse": "#FFFFFF", "text.accent": "#4F46E5",
      "border.subtle": "#E8EBF2", "border.default": "#DCE1EB", "border.strong": "#C5CDDD", "border.accent": "#818CF8",
      "accent.default": "#4F46E5", "accent.hover": "#4338CA", "accent.soft": "rgba(79,70,229,.08)",
      "status.success": "#16A34A", "status.warning": "#D97706", "status.danger": "#DC2626", "status.info": "#0284C7"
    }
  }
}
